# Organizer palette (hackathon.softwareforge.ai): canvas #0E0E0F, text #FAF5F4, accent #FFB028.
# Imported by every diagram so a colour changes in one place.
vars: {
  d2-config: {
    layout-engine: elk
    pad: 24
  }
}
style: {
  fill: "#0E0E0F"
}
classes: {
  box: {
    style: {
      fill: "#17171A"
      stroke: "#2C2C31"
      font-color: "#FAF5F4"
      border-radius: 10
      font-size: 30
      stroke-width: 2
    }
  }
  hot: {
    style: {
      fill: "#2A2110"
      stroke: "#FFB028"
      font-color: "#FFB028"
      border-radius: 10
      font-size: 30
      stroke-width: 3
      bold: true
    }
  }
  bad: {
    style: {
      fill: "#2A1311"
      stroke: "#FF5A4E"
      font-color: "#FF8A80"
      border-radius: 10
      font-size: 30
      stroke-width: 3
      bold: true
    }
  }
  good: {
    style: {
      fill: "#10241A"
      stroke: "#5BD68A"
      font-color: "#8BE6AE"
      border-radius: 10
      font-size: 30
      stroke-width: 3
      bold: true
    }
  }
  ask: {
    shape: diamond
    style: {
      fill: "#17171A"
      stroke: "#A9A4A2"
      font-color: "#FAF5F4"
      font-size: 27
      stroke-width: 2
    }
  }
  flow: {
    style: {
      stroke: "#6F6B6A"
      font-color: "#A9A4A2"
      font-size: 24
      stroke-width: 2
    }
  }
  flow-hot: {
    style: {
      stroke: "#FFB028"
      font-color: "#FFB028"
      font-size: 24
      stroke-width: 3
    }
  }
  flow-bad: {
    style: {
      stroke: "#FF5A4E"
      font-color: "#FF8A80"
      font-size: 24
      stroke-width: 3
    }
  }
}
