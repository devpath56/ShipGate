    "@vitejs/plugin-react": "^4.7.0",
    "fastify": "^5.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vitest": "^3.2.7"
